{
  "name": "shipcheck",
  "version": "1.0.0",
  "private": true,
  "description": "ShipCheck - shipment tracking & exception management with carrier-agnostic REST adapter, webhook ingest, public tracking pages, and CSV import.",
  "license": "MIT",
  "homepage": "https://github.com/shivang-jindal/ShipCheck#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivang-jindal/ShipCheck.git"
  },
  "bugs": {
    "url": "https://github.com/shivang-jindal/ShipCheck/issues"
  },
  "keywords": [
    "shipment",
    "tracking",
    "logistics",
    "carrier",
    "webhook",
    "csv-import",
    "public-tracking",
    "saas",
    "react",
    "express",
    "drizzle",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @shipcheck/shared",
    "build:server": "npm run build -w @shipcheck/server",
    "build:client": "npm run build -w @shipcheck/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "typecheck": "npm run build:shared && npm run typecheck -w @shipcheck/server && npm run typecheck -w @shipcheck/client",
    "lint": "eslint .",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @shipcheck/server",
    "db:migrate": "npm run db:migrate -w @shipcheck/server",
    "db:seed": "npm run db:seed -w @shipcheck/server",
    "dev:server": "npm run dev -w @shipcheck/server",
    "dev:client": "npm run dev -w @shipcheck/client",
    "dev:worker": "npm run worker -w @shipcheck/server",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start -w @shipcheck/server",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
