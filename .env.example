# CollectFlow - example environment
# Copy to `.env` and fill in real values. NEVER commit a filled-in .env file.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the API (used in emailed links and CORS allow-listing).
API_URL=http://localhost:4000
# Public URL of the web client.
APP_URL=http://localhost:5173
# Optional extra allowed origins, comma separated.
# APP_URLS=https://app.example.com

# ---- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite PostgreSQL build
# (local development and tests only). Set it to a real PostgreSQL connection
# string for any shared or production deployment.
# DATABASE_URL=postgresql://user:password@host:5432/collectflow
PGLITE_DATA_DIR=.data/pgdata
DATABASE_POOL_MAX=10

# ---- Email -----------------------------------------------------------------
# disabled | smtp | log
#   disabled - no provider; the UI shows "Not connected".
#   smtp     - real delivery through your SMTP provider.
#   log      - DEVELOPMENT ONLY. Captures messages to server/.data/outbox and
#              never delivers them. Refused when NODE_ENV=production.
EMAIL_PROVIDER=disabled
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
FROM_EMAIL=billing@yourdomain.example
# EMAIL_REPLY_TO=

# ---- Security --------------------------------------------------------------
# 32-byte key, 64 hex characters. Required before any integration credential
# can be stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=
SESSION_COOKIE_NAME=collectflow_session
SESSION_TTL_HOURS=336
# Set to true behind HTTPS (it defaults to true when NODE_ENV=production).
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- Background worker -----------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=3
# Set to true only for a single-process deployment.
WORKER_IN_API=false

# ---- Google sign-in (Firebase) --------------------------------------------
# The Firebase web configuration is public by design: it identifies the project,
# not a person. The browser needs the VITE_* values; the API needs the project id
# so it can verify the ID token Google issues. Google is the only way into the
# web app: there is no password form, registration page or reset link. Leave
# these empty and the button shows an honest "not configured" state instead of
# failing after a click. Password endpoints exist only for development seeding
# and automated tests; they return 404 when NODE_ENV=production.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=your-project
# ---- Observability ---------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Optional development seed --------------------------------------------
# Only used by `npm run db:seed`. The seed command refuses to run in production.
# SEED_DEMO_DATA=false
# SEED_EMAIL=demo@shipcheck.test
# SEED_PASSWORD=shipcheck-demo-1234